=== disallowUnerasableAssertionUnaryExponentiation.ts ===
// https://github.com/microsoft/TypeScript/issues/65170

// '-x ** y' is a syntax error in JavaScript. Erasing 'as T' or 'satisfies T' in '-x as T ** y'
// leaves exactly that, so the unary expression must be parenthesized here as well.

declare let x: number;
>x : Symbol(x, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 5, 11))

declare let o: { p?: number };
>o : Symbol(o, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 6, 11))
>p : Symbol(p, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 6, 16))

declare let p: Promise<number>;
>p : Symbol(p, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 7, 11))
>Promise : Symbol(Promise, Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.iterable.d.ts, --, --), Decl(lib.es2015.promise.d.ts, --, --), Decl(lib.es2015.symbol.wellknown.d.ts, --, --), Decl(lib.es2018.promise.d.ts, --, --))

export const a01 = -x as number ** 2;  // Error
>a01 : Symbol(a01, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 9, 12))
>x : Symbol(x, Decl(disallowUnerasableAssertionUnaryExponentiation.ts, 5, 11))

