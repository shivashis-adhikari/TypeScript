>(x as number ** 2) : number
>x as number ** 2 : number
>x as number : number
>x : number
>2 : 2

// Unary expressions on the right of '**' are fine.
export const c08 = 2 ** -x as number;
>c08 : number
>2 ** -x as number : number
>2 ** -x : number
>2 : 2
>-x : number
>x : number

